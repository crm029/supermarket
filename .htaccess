RewriteEngine On

# Keep source, deployment, database and test files out of the public web.
RewriteRule ^\.well-known/ - [L]
RewriteRule ^(?:app|database|bin|tests|docs|scripts)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:README\.md|THIRD_PARTY_NOTICES\.md)$ - [F,L,NC]

# Tenant-aware SEO endpoints and crawlable catalogue URLs.
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap-core\.xml$ sitemap-core.php [L]
RewriteRule ^sitemap-products-([1-9][0-9]*)\.xml$ sitemap-products.php?page=$1 [L]
RewriteRule ^product/([1-9][0-9]*)(?:/([a-z0-9][a-z0-9-]{0,179}))?/?$ product.php?id=$1&slug=$2 [L,QSA]
RewriteRule ^category/([a-z0-9][a-z0-9-]{0,139})/?$ category.php?slug=$1 [L,QSA]
