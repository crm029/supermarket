APP_NAME="Supermarket 360"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/supermarket
# Set a unique random secret of at least 32 characters.
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supermarket360
DB_USERNAME=root
DB_PASSWORD=

# Optional public HTTPS media base URL.
MEDIA_BASE_URL=

# Development only: OTP is written to the PHP error log. Never use in production.
SMS_PROVIDER=log

SMS_API_KEY=
ZARINPAL_MERCHANT_ID=
