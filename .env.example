APP_NAME="Supermarket 360"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/supermarket
# Public, verified store origin used for payment callbacks. Must be HTTPS in production.
APP_BASE_URL=http://localhost/supermarket
# Set a unique random secret of at least 32 characters.
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supermarket360
DB_USERNAME=root
DB_PASSWORD=

# Optional public HTTPS media base URL.
MEDIA_BASE_URL=
# Absolute path outside the public web root; expose it through a restricted static/CDN mapping.
MEDIA_STORAGE_PATH=

# Development only: OTP is written to the PHP error log. Never use in production.
SMS_PROVIDER=log
# Production option: SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=

SMS_API_KEY=
# Public ZarinPal sandbox merchant UUID supplied for this project; replace only when using another merchant.
# This is a sandbox identifier, not a live merchant credential. Keep sandbox mode enabled.
ZARINPAL_MERCHANT_ID=50cd6e57-81b9-4f2b-9aff-6ce699f4b56d
# Safe default. The platform owner can select Sandbox or Real in platform.php.
ZARINPAL_SANDBOX=true

# Retain read notifications for this many days (30–3650); unread notifications are never pruned.
NOTIFICATION_READ_RETENTION_DAYS=180

# Referral reward rate in basis points (100 = 1%). Zero disables rewards until configured.
REFERRAL_REWARD_BASIS_POINTS=0

# SaaS renewal invoices are issued this many days before period end (1–30).
SUBSCRIPTION_BILLING_LEAD_DAYS=7
# Keep stores active during this grace period before marking subscriptions past_due (0–30 days).
SUBSCRIPTION_GRACE_DAYS=7
# Maximum subscriptions processed in each worker pass (1–500).
SUBSCRIPTION_BILLING_BATCH_SIZE=100

# Send one in-app reminder this many days before SaaS invoice due date (1–14).
SUBSCRIPTION_REMINDER_LEAD_DAYS=3
